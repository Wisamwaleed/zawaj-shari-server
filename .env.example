# رابط اتصال PostgreSQL (من Neon مثلاً)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# سر توقيع الجلسات - غيّره إلى قيمة عشوائية طويلة
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# منفذ الخادم
PORT=4000

# أصل الواجهة المسموح له (CORS)
CLIENT_ORIGIN=http://localhost:5173

# مجلد حفظ الصور
UPLOAD_DIR=uploads
